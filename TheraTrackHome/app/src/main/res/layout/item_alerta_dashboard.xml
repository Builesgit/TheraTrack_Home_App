<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_alert_item">

    <ImageView
        android:id="@+id/ivAlertaIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_warning_white"
        android:background="@drawable/bg_circle_red_solid"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvAlertaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alerta"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tvAlertaMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje de alerta"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAlertaTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="urgente"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/colorRedAlert"
        android:background="@drawable/bg_badge_red"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginStart="8dp"/>
</LinearLayout>
