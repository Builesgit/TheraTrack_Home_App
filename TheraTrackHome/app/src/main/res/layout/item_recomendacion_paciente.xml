<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_metric_card"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/fIconoRec"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_blue_light"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivIconoRec"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_medical"
            app:tint="@color/colorPrimary"
            android:layout_gravity="center"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRecTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Título"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"/>

            <TextView
                android:id="@+id/tvRecNueva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUEVA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:background="@drawable/bg_badge_blue"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvRecTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="general"
            android:textSize="10sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/colorTextSecondary"
        android:layout_marginStart="8dp"/>

</LinearLayout>
