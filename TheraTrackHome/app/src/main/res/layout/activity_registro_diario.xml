<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBgLight">

    <!-- ─── CONTENIDO SCROLLABLE ─── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- ═══════════════════════════════════════
                 HEADER
                 ═══════════════════════════════════════ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_back"
                    android:padding="4dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar Síntomas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

            <!-- ═══════════════════════════════════════
                 CARD INTRO AZUL
                 ═══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorBlueBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_nav_symptoms"
                            app:tint="@color/white"
                            android:layout_gravity="center"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registre cómo se siente hoy"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Su seguimiento diario ayuda al equipo médico a monitorizar su evolución tras el tratamiento."
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════════════
                 SÍNTOMAS ACTUALES
                 ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SÍNTOMAS ACTUALES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <!-- Fila síntoma: FATIGA -->
            <LinearLayout
                android:id="@+id/rowFatiga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_orange_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="#F59E0B"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fatiga"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkFatiga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <!-- Fila síntoma: NÁUSEAS -->
            <LinearLayout
                android:id="@+id/rowNauseas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_blue_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_drop"
                        app:tint="@color/colorPrimary"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Náuseas"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkNauseas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <!-- Fila síntoma: DOLOR -->
            <LinearLayout
                android:id="@+id/rowDolor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_red_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_alert_white"
                        app:tint="@color/colorRedAlert"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dolor o molestias"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkDolor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <!-- Fila síntoma: IRRITACIÓN -->
            <LinearLayout
                android:id="@+id/rowIrritacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_orange_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/colorOrangeCaution"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Irritación"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkIrritacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <!-- Fila síntoma: MAREO -->
            <LinearLayout
                android:id="@+id/rowMareo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_purple_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_wind"
                        app:tint="#8B5CF6"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mareo"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkMareo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <!-- Fila síntoma: NINGUNO -->
            <LinearLayout
                android:id="@+id/rowNinguno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_symptom_normal"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_green_light"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check_white"
                        app:tint="@color/colorGreenSafe"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ninguno"
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="14dp"/>

                <CheckBox
                    android:id="@+id/checkNinguno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/colorGreenSafe"/>
            </LinearLayout>

            <!-- ═══════════════════════════════════════
                 OBSERVACIONES
                 ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OBSERVACIONES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Escriba aquí cualquier detalle adicional sobre cómo se encuentra hoy..."
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:padding="14dp"
                android:background="@drawable/bg_symptom_normal"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ─── BOTÓN GUARDAR (siempre visible) ─── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="Guardar registro"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="14dp"/>

    <!-- ─── BOTTOM NAVIGATION ─── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        app:elevation="12dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"/>

</LinearLayout>
