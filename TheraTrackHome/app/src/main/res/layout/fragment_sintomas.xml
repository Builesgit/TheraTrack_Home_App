<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Volver"
                android:src="@drawable/ic_back"
                app:tint="#111827" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Registrar Síntomas"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:background="@drawable/bg_sintomas_top"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="Síntomas"
                    android:src="@drawable/ic_medical_cross"
                    app:tint="#2563EB" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Registre cómo se siente hoy"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Esta información ayuda a su equipo médico a monitorear su recuperación tras el tratamiento radiofarmacéutico."
                android:textColor="#6B7280"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:text="SÍNTOMAS ACTUALES"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/itemFatiga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Fatiga"
                android:src="@drawable/ic_fatiga"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Fatiga"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkFatiga"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar fatiga"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemNauseas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Náuseas"
                android:src="@drawable/ic_nauseas"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Náuseas"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkNauseas"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar náuseas"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemDolor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Dolor o molestias"
                android:src="@drawable/ic_dolor"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Dolor o molestias"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkDolor"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar dolor o molestias"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemIrritacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Irritación"
                android:src="@drawable/ic_irritacion"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Irritación"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkIrritacion"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar irritación"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemMareo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Mareo"
                android:src="@drawable/ic_mareo"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Mareo"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkMareo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar mareo"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemNinguno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_sintoma"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Ninguno"
                android:src="@drawable/ic_check_circle"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Ninguno"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/checkNinguno"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Seleccionar ninguno"
                android:src="@drawable/ic_check_unselected" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:text="OBSERVACIONES"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="Escriba aquí cualquier detalle adicional..."
            android:padding="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="12dp"
            android:text="Guardar registro"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#1D4ED8"
            app:cornerRadius="18dp" />

    </LinearLayout>

</ScrollView>