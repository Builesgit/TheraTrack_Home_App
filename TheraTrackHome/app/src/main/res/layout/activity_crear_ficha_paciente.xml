<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBgLight">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:paddingBottom="16dp"
        android:background="@color/colorCardBg">

        <ImageView
            android:id="@+id/btnVolverFicha"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:padding="4dp"
            android:layout_marginEnd="12dp"
            app:tint="@color/colorTextPrimary"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva ficha clínica"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"/>

            <TextView
                android:id="@+id/tvFichaPacienteNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Radiofármaco -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radiofármaco *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etRadiofarmaco"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej.: Yodo-131"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- Dosis MBq -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosis (MBq)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etDosisMbq"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej.: 5550"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp"/>

            <!-- Fecha tratamiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de tratamiento * (AAAA-MM-DD)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etFechaTratamiento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="2025-06-15"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- Fecha alta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de alta * (AAAA-MM-DD)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etFechaAlta"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="2025-06-17"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- Días de aislamiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Días de aislamiento *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etDiasAislamiento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="7"
                android:text="7"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>

            <!-- Notas clínicas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas clínicas"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etNotasClinicas"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Observaciones, contraindicaciones..."
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearFicha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Aprobar paciente y crear ficha"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
