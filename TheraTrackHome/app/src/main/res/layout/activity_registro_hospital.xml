<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgLight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:padding="4dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerInParent="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/logo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TheraTrack"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESO PROFESIONAL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:background="@drawable/bg_circle_blue_light"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicitud de acceso"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rellena el formulario. El hospital validará tu solicitud antes de darte acceso."
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="24dp"/>

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre y apellidos"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Dr./Dra. Nombre Apellidos"
            android:inputType="textPersonName|textCapWords"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- Número de colegiado con ayuda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Número de colegiado"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"/>

            <ImageView
                android:id="@+id/btnAyudaColegiado"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_help"
                android:contentDescription="Ayuda número de colegiado"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etColegiado"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ej: 281234567"
            android:inputType="number"
            android:maxLength="10"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- Hospital -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital o centro"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerHospital"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- Cargo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerCargo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- Teléfono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teléfono de contacto"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="+34 600 000 000"
            android:inputType="phone"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- Motivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivo de la solicitud"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etMotivo"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Describe brevemente tu rol y el motivo por el que necesitas acceso."
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:layout_marginBottom="14dp"/>

        <!-- PIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIN de acceso (6 dígitos)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:boxBackgroundMode="none"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Elige un PIN de 6 dígitos"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:background="@drawable/bg_input"
                android:padding="15dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar PIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar PIN"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:boxBackgroundMode="none"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Repite tu PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:background="@drawable/bg_input"
                android:padding="15dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Checkbox privacidad -->
        <CheckBox
            android:id="@+id/checkPrivacidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acepto la política de privacidad y el tratamiento de datos profesionales."
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="20dp"/>

        <!-- Botón enviar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Enviar solicitud"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
