<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El CIPA (Código de Identificación Personal Autonómico) es el número de 10 dígitos que identifica tu tarjeta sanitaria."
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puedes encontrarlo en tu tarjeta sanitaria física, en el centro o en el lateral derecho según la antigüedad de la tarjeta:"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp"/>

        <ImageView
            android:id="@+id/ivTarjetaSanitaria"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:adjustViewBounds="true"
            android:src="@drawable/img_tarjeta_sanitaria"
            android:scaleType="fitCenter"
            android:contentDescription="Imagen de tarjeta sanitaria mostrando ubicación del CIPA"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El CIPA aparece en el anverso de la tarjeta sanitaria."
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejemplo: 1724979086"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"/>

    </LinearLayout>
</ScrollView>
